# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly enforce LF line endings on scripts, code, and configs for Linux compatibility
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.html text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pyc binary
